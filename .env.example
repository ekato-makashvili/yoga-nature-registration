# სერვერის პორტი / Server port
PORT=3000

# საჯარო მისამართი, საიდანაც თქვენი საიტი ხელმისაწვდომია ინტერნეტში.
# Flitt-მა უნდა შეძლოს ამ მისამართზე callback-ის გაგზავნა, ამიტომ ლოკალურ
# გარემოში http://localhost სამუშაოდ არ გამოდგება - გამოიყენეთ ngrok
# ან მსგავსი tunneling ხელსაწყო, production-ში კი თქვენი რეალური დომენი.
#
# Public URL where your site is reachable from the internet. Flitt needs to
# be able to reach this address for callbacks, so localhost will NOT work
# for real payments - use ngrok (or similar) locally, and your real domain
# in production.
PUBLIC_BASE_URL=http://localhost:3000

# Flitt-ის მერჩანტის ID და საიდუმლო გასაღები.
# სატესტოდ (sandbox) გამოიყენეთ Flitt-ის საჯარო ტესტ მონაცემები:
#   FLITT_MERCHANT_ID=1549901
#   FLITT_SECRET_KEY=test
# production-ში ეს ორივე შეცვალეთ თქვენი საკუთარი, დამტკიცებული
# მერჩანტის ანგარიშის მონაცემებით (Flitt-ის მერჩანტის დაშბორდიდან,
# Technical Settings სექციაში).
#
# Flitt merchant ID and secret key.
# For testing (sandbox), use Flitt's public test credentials:
#   FLITT_MERCHANT_ID=1549901
#   FLITT_SECRET_KEY=test
# In production, replace both with your own approved merchant account's
# values (from the Flitt merchant dashboard, Technical Settings section).
FLITT_MERCHANT_ID=1549901
FLITT_SECRET_KEY=test